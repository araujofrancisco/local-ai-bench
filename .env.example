# Copy to `.env` and adjust for your deployment:
#   cp .env.example .env
# Docker Compose loads `.env` automatically; the container's environment is
# defined in docker-compose.yml.

# Ollama endpoint used when `hosts` is omitted from the config.
# The default (host.docker.internal) does not resolve on Linux Docker Engine
# without an extra_hosts host-gateway mapping, so point at your real Ollama host.
OLLAMA_HOST=http://192.168.10.108:11434

# Path to the YAML configuration inside the container.
CONFIG_PATH=/config/default.yaml

# Path to the SQLite database file inside the container.
DATABASE_URL=/data/benchmark.db

# Where the compiled frontend assets live (leave default).
STATIC_DIR=/app/static

# Comma-separated CORS allow-list. Lock this down in production,
# e.g. https://bench.example.com
CORS_ORIGINS=*

# Optional: where backend logs are written.
# LOG_FILE=/data/local-ai-bench.log
