---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Compare Models">
  <h1>Model Comparison</h1>

  <div id="error" style="display: none; background: #ef4444; color: white; padding: 1rem; border-radius: 0.5rem; margin-bottom: 2rem;"></div>

  <!-- Column customization panel -->
  <div id="column-panel" style="position:relative;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.5rem;">
      <div style="display:flex; align-items:center; gap:.5rem;">
        <span style="color:#e2e8f0; font-size:.9rem; font-weight:500;">Columns</span>
        <button id="toggle-columns" type="button" aria-expanded="false" style="background:#0f172a; color:#94a3b8; border:1px solid #334155; border-radius:.25rem; padding:.15rem .5rem; cursor:pointer; font-size:.75rem;">▾</button>
        <button id="reset-columns" type="button" style="background:transparent; color:#94a3b8; border:1px solid #334155; border-radius:.25rem; padding:.15rem .5rem; cursor:pointer; font-size:.75rem;">Reset</button>
        <button id="toggle-weights" type="button" style="background:#0f172a; color:#e2e8f0; border:1px solid #334155; border-radius:.25rem; padding:.15rem .5rem; cursor:pointer; font-size:.75rem;">⚖ Weights</button>
      </div>
    </div>
    <div id="columns-popover" style="display:none; position:absolute; top:100%; right:0; z-index:50; width:440px; max-width:90vw; max-height:60vh; overflow-y:auto; background:#1e293b; border:1px solid #334155; border-radius:.5rem; padding:1rem; box-shadow:0 10px 30px rgba(0,0,0,.5);">
      <div style="display:flex; align-items:center; gap:.5rem; margin-bottom:.75rem;">
        <input id="column-search" type="text" placeholder="Filter columns…" style="flex:1; background:#0f172a; color:#e2e8f0; border:1px solid #334155; border-radius:.25rem; padding:.35rem .6rem; font-size:.8rem;">
        <button id="cols-all" type="button" data-cols-action="all" style="background:transparent; color:#3b82f6; border:1px solid #334155; border-radius:.25rem; padding:.25rem .6rem; cursor:pointer; font-size:.75rem;">All</button>
        <button id="cols-none" type="button" data-cols-action="none" style="background:transparent; color:#94a3b8; border:1px solid #334155; border-radius:.25rem; padding:.25rem .6rem; cursor:pointer; font-size:.75rem;">Clear</button>
      </div>
      <div id="column-count" style="margin-bottom:.5rem; color:#94a3b8; font-size:.75rem;"></div>
      <div id="column-groups"></div>
    </div>
  </div>

  <!-- Category weights panel -->
  <div id="weights-panel" style="display:none; margin-top:.5rem; background:#0f172a; border:1px solid #334155; border-radius:.5rem; padding:1rem;">
    <div style="display:flex; align-items:center; gap:.5rem; margin-bottom:.75rem;">
      <span style="color:#e2e8f0; font-size:.9rem; font-weight:500;">Category weights</span>
      <span style="color:#64748b; font-size:.8rem;">Weighting controls each category's contribution to the weighted score below. Saved weights also apply to future runs.</span>
    </div>
    <div id="weights-inputs" style="display:flex; flex-wrap:wrap; gap:1rem;"></div>
    <div style="display:flex; gap:.75rem; margin-top:1rem;">
      <button id="weights-save" type="button" style="background:#3b82f6; color:white; border:none; border-radius:.375rem; padding:.375rem 1rem; cursor:pointer; font-size:.85rem;">Save weights</button>
      <button id="weights-reset" type="button" style="background:transparent; color:#94a3b8; border:1px solid #334155; border-radius:.375rem; padding:.375rem 1rem; cursor:pointer; font-size:.85rem;">Reset to defaults</button>
    </div>
  </div>

  <div id="compare">
    <p style="color: #94a3b8;">Loading comparison…</p>
  </div>

  <script>
    import { esc, toast, confirmModal, thInfo, formatNum, scoreColor } from '../scripts/ui.js';

    const HINTS = {
      'Model': 'Model name (also includes the Run when comparing multiple runs).',
      'Run': 'Benchmark run this model belongs to (only shown for multi-run comparisons).',
      'Score': 'Weighted mean of plugin scores (higher is better).',
      'p50 (ms)': 'Median generation latency — half of generations finish faster, half slower.',
      'p95 (ms)': 'Tail latency: 95% of generations finish within this time. Sensitive to slow decodes/outliers.',
      'TTFT p50': 'Median time to first token — measures prompt processing + first-token latency.',
      'Tokens/s': 'Output tokens generated per second (throughput).',
      'Cases': 'Number of benchmark cases that completed.',
      'Errors': 'Number of failed cases for this model.',
    };

    const fmtTokens = (n) => {
      n = Number(n);
      if (!n && n !== 0) return null;
      if (n >= 1000) return (n / 1000).toFixed(n % 1000 ? 1 : 0).replace(/\.0$/, '') + 'K';
      return String(n);
    };

    const pluginContextSizes = (row, pluginId) => {
      const p = (row.plugins || []).find((x) => x.plugin_id === pluginId);
      if (!p || !p.metrics) return null;
      try {
        const keys = Object.keys(JSON.parse(p.metrics).per_context_score || {});
        if (keys.length) return keys.map(fmtTokens).join('/');
      } catch { /* ignore */ }
      return null;
    };

    const pluginMetricsTooltip = (row, pluginId) => {
      const p = (row.plugins || []).find((x) => x.plugin_id === pluginId);
      if (!p || !p.metrics) return null;
      let m;
      try { m = JSON.parse(p.metrics); } catch { return null; }
      if (!m) return null;
      const parts = [];
      if (m.pass_at_1 != null) parts.push('pass@1 ' + formatNum(m.pass_at_1, 3));
      if (m.syntax_ok_ratio != null) parts.push('syntax ok ' + formatNum(m.syntax_ok_ratio, 3));
      if (m.tests_total != null) {
        const ratio = m.tests_pass_ratio != null ? formatNum(m.tests_pass_ratio, 3) : null;
        parts.push('tests ' + m.tests_passed_total + '/' + m.tests_total + (ratio != null ? ' (' + ratio + ')' : ''));
      }
      if (m.perf_checked_cases) {
        const ok = m.complexity_ok_ratio != null ? formatNum(m.complexity_ok_ratio, 3) : null;
        parts.push('perf checked ' + m.perf_checked_cases + (ok != null ? ' · ok ' + ok : ''));
      }
      if (m.approach_penalized_cases) {
        parts.push('penalized ' + m.approach_penalized_cases);
      }
      if (m.judge_scored_cases) {
        parts.push('judge ' + m.judge_scored_cases);
      }
      return parts.length ? parts.join(' · ') : null;
    };

    // Column registry: key -> {label, hint, group, type, align, extract, format?, color?, defaultVisible}
    function buildColumns(plugins, compareDefaultIds, isMultiRun = false) {
      // Fallback: if compare_default is empty, use plugins that have weights defined
      // (these are the "core" plugins that contribute to the overall score)
      const WEIGHTED_PLUGINS = new Set([
        'translation', 'coding', 'vision', 'summarization', 
        'reasoning', 'structured_output', 'long_context'
      ]);
      
      const compareDefault = new Set(compareDefaultIds || []);
      const useFallback = compareDefault.size === 0;
      const cols = {
        model: { label: 'Model', hint: HINTS.Model, group: 'General', type: 'text', align: 'left',
          extract: (r) => r.model_name, defaultVisible: true },
        run: { label: 'Run', hint: HINTS.Run, group: 'General', type: 'text', align: 'left',
          extract: (r) => r.run_id, defaultVisible: isMultiRun },
        score: { label: 'Score', hint: HINTS.Score, group: 'General', type: 'number', align: 'right',
          extract: (r) => r.overall_score, format: (v) => formatNum(v, 3), color: (v) => scoreColor(v), defaultVisible: true },
        weighted: { label: 'Weighted', hint: 'Overall score recomputed live from per-plugin scores using the current category weights.', group: 'General', type: 'number', align: 'right',
          extract: (r) => weightedScore(r), format: (v) => formatNum(v, 3), color: (v) => scoreColor(v), defaultVisible: true },
        p50: { label: 'p50 (ms)', hint: HINTS['p50 (ms)'], group: 'Latency', type: 'number', align: 'right',
          extract: (r) => r.latency_p50_ms, defaultVisible: false },
        p95: { label: 'p95 (ms)', hint: HINTS['p95 (ms)'], group: 'Latency', type: 'number', align: 'right',
          extract: (r) => r.latency_p95_ms, defaultVisible: false },
        ttft: { label: 'TTFT p50', hint: HINTS['TTFT p50'], group: 'Latency', type: 'number', align: 'right',
          extract: (r) => r.time_to_first_token_p50_ms, defaultVisible: false },
        tps: { label: 'Tokens/s', hint: HINTS['Tokens/s'], group: 'Latency', type: 'number', align: 'right',
          extract: (r) => r.tokens_per_second, defaultVisible: false },
        cases: { label: 'Cases', hint: HINTS.Cases, group: 'General', type: 'number', align: 'right',
          extract: (r) => r.cases_run, defaultVisible: false },
        errors: { label: 'Errors', hint: HINTS.Errors, group: 'General', type: 'number', align: 'right',
          extract: (r) => r.errors, color: (v) => (v > 0 ? '#ef4444' : 'inherit'), defaultVisible: false },
        context: { label: 'Context', hint: 'Context window the model was benchmarked at. When unset, shows the context sizes exercised by the multi-context plugin.', group: 'General', type: 'text', align: 'right',
          extract: (r) => r.max_context_tokens ? fmtTokens(r.max_context_tokens) : pluginContextSizes(r, 'multi_context'), defaultVisible: true },
      };
      // Per-plugin columns: a score column per active plugin (default-on,
      // driven by the server's `compare_default` config list; empty => all run
      // plugins default-on) plus an opt-in Tokens/s column. No per-plugin
      // latency columns.
      const seen = new Set();
      const active = (plugins || []);
      for (const p of active) {
        const id = p.plugin_id;
        if (seen.has(id)) continue;
        seen.add(id);
        cols[`plugin:${id}:score`] = {
          label: `${id} score`, hint: `Plugin '${id}' weighted score for this model.`,
          group: 'Per-plugin', type: 'number', align: 'right',
          extract: (r) => (r.plugins || []).find((x) => x.plugin_id === id)?.score ?? null,
          format: (v) => formatNum(v, 3), color: (v) => scoreColor(v),
          defaultVisible: useFallback ? WEIGHTED_PLUGINS.has(id) : compareDefault.has(id),
        };
        cols[`plugin:${id}:tps`] = {
          label: `${id} Tokens/s`, hint: `Plugin '${id}' output tokens per second.`,
          group: 'Per-plugin', type: 'number', align: 'right',
          extract: (r) => (r.plugins || []).find((x) => x.plugin_id === id)?.tokens_per_second ?? null,
          defaultVisible: false,
        };
      }
      return cols;
    }

    // --- localStorage persistence helpers ---
    const VISIBLE_KEY = 'compare.columns.visible.v3';
    const ORDER_KEY = 'compare.columns.order.v3';
    const storage = {
      order: (cols) => JSON.parse(localStorage.getItem(ORDER_KEY) || 'null') || Object.keys(cols),
      orderOk: (cols) => {
        const o = JSON.parse(localStorage.getItem(ORDER_KEY) || 'null') || [];
        const keys = o.filter((k) => cols[k]);
        for (const k of Object.keys(cols)) if (!keys.includes(k)) keys.push(k);
        localStorage.setItem(ORDER_KEY, JSON.stringify(keys));
        return keys;
      },
      visible: () => {
        const raw = localStorage.getItem(VISIBLE_KEY);
        if (!raw) return null; // null => all columns visible
        try { return new Set(JSON.parse(raw)); } catch { return null; }
      },
      setVisible: (keys) => localStorage.setItem(VISIBLE_KEY, JSON.stringify([...keys])),
      sort: () => JSON.parse(localStorage.getItem('compare.sort') || 'null') || { key: 'score', dir: 'desc' },
      setSort: (key, dir) => localStorage.setItem('compare.sort', JSON.stringify({ key, dir })),
    };

    const sortRows = (rows, cols, by, dir) => {
      const col = cols[by];
      if (!col) return rows;
      const extract = col.extract;
      const cmp = (a, b) => {
        const av = extract(a);
        const bv = extract(b);
        const an = Number(av), bn = Number(bv);
        const avn = Number.isNaN(an), bvn = Number.isNaN(bn);
        if (avn && bvn) return 0;
        if (avn) return 1; // nulls last
        if (bvn) return -1;
        if (!avn && !bvn) return an < bn ? -1 : an > bn ? 1 : 0;
        return String(av) < String(bv) ? -1 : String(av) > String(bv) ? 1 : 0;
      };
      const sorted = [...rows].sort(cmp);
      return dir === 'desc' ? sorted.reverse() : sorted;
    };

    const visibleKeys = (cols) => {
      const order = storage.order(cols);
      const v = storage.visible();
      return order.filter((k) => cols[k] && (v === null || v.has(k)));
    };

    const headerRow = (runIds, cols) => {
      const isMulti = runIds.length > 1;
      if (isMulti) {
        return `<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; background:#1e293b; padding:.75rem 1rem; border-radius:.5rem; border:1px solid #334155;">
          <span style="color:#94a3b8; font-size:.875rem;">Runs: ${esc(runIds.join(', '))}</span>
          <button data-delete-run="${runIds.map((r) => esc(r)).join(',')}" style="background:transparent; color:#ef4444; border:1px solid #7f1d1d; padding:.375rem .875rem; border-radius:.375rem; cursor:pointer; font-size:.875rem;">Delete runs</button>
        </div>`;
      }
      if (runIds.length === 1) {
        return `<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; background:#1e293b; padding:.75rem 1rem; border-radius:.5rem; border:1px solid #334155;">
          <span style="color:#94a3b8; font-size:.875rem;">Run <code style="background:#0f172a; padding:.125rem .375rem; border-radius:.25rem;">${esc(runIds[0])}</code></span>
          <button data-delete-run="${esc(runIds[0])}" style="background:transparent; color:#ef4444; border:1px solid #7f1d1d; padding:.375rem .875rem; border-radius:.375rem; cursor:pointer; font-size:.875rem;">Delete run</button>
        </div>`;
      }
      return '';
    };

    const compareTable = (rows, runIds, cols) => {
      const keys = visibleKeys(cols);
      const s = storage.sort();
      return headerRow(runIds, cols) + `
      <div style="overflow-x:auto; background:#1e293b; border-radius:.5rem; border:1px solid #334155;">
        <table style="width:100%; border-collapse:collapse;">
          <thead>
            <tr style="border-bottom:1px solid #334155; background:rgba(255,255,255,0.02);">
              ${keys.map((k) => thInfo(cols[k].label, cols[k].align, cols[k].hint,
                { sortable: true, sortKey: k, sortDir: s.key === k ? s.dir : null })).join('')}
            </tr>
          </thead>
          <tbody>
            ${sortRows(rows, cols, s.key, s.dir).map((row, i) => `
              <tr style="border-bottom:1px solid #334155; background:${i % 2 === 0 ? 'transparent' : 'rgba(255,255,255,0.02)'};">
                ${keys.map((k) => {
                   const c = cols[k];
                   const val = c.extract(row);
                   const color = (typeof c.color === 'function') ? c.color(val) : 'inherit';
                   const display = typeof c.format === 'function' ? c.format(val) : (val === null || val === undefined ? '-' : esc(val));
                   const isNum = c.type === 'number' && val != null && !Number.isNaN(Number(val));
                   const isPluginScore = k.startsWith('plugin:') && k.endsWith(':score');
                   const pluginId = isPluginScore ? k.slice(7, -6) : null;
                   const tip = isPluginScore ? pluginMetricsTooltip(row, pluginId) : null;
                   const titleAttr = tip ? ` title="${esc(tip)}"` : '';
                   return `<td style="text-align:${c.align}; padding:1rem; color:${color}; ${isNum ? 'font-variant-numeric:tabular-nums;' : ''}"${titleAttr}>${display}</td>`;
                 }).join('')}
              </tr>`).join('')}
          </tbody>
        </table>
      </div>
      <div style="margin-top:1rem; display:flex; flex-wrap:wrap; gap:1.5rem; font-size:.8rem; color:#64748b;">
        <span><strong>p50/p95 (ms)</strong>: median / 95th-percentile generation latency across cases.</span>
        <span><strong>TTFT p50</strong>: median time to first token (prompt processing + first-token latency).</span>
        <span><strong>Tokens/s</strong>: output tokens per second (throughput).</span>
      </div>
      <div style="margin-top:1.5rem;">
        <button id="show-errors" type="button" style="background:#0f172a; color:#e2e8f0; border:1px solid #334155; border-radius:.375rem; padding:.375rem .875rem; cursor:pointer; font-size:.85rem;">Show per-case errors</button>
      </div>
      <div id="errors-detail" style="margin-top:.75rem;"></div>
      <div style="margin-top:2rem; display:flex; gap:1rem;">
        <a href="/run" style="background:#3b82f6; color:white; padding:.75rem 2rem; border-radius:.375rem; text-decoration:none; font-weight:500;">Run More Benchmarks</a>
        <a href="/history" style="background:#64748b; color:white; padding:.75rem 2rem; border-radius:.375rem; text-decoration:none; font-weight:500;">View History</a>
      </div>`;
    };

    const emptyState = () => `
      <div style="background:#1e293b; padding:2rem; border-radius:.5rem; border:1px solid #334155; text-align:center;">
        <p style="color:#94a3b8; margin-bottom:1rem;">No benchmark data available yet.</p>
        <a href="/run" style="color:#3b82f6; text-decoration:none; font-weight:500;">Run your first benchmark →</a>
      </div>`;

    let currentRunIds = [];
    let currentCols = {};
    let defaultWeights = {};
    let currentWeights = {};
    const categoryOf = {}; // plugin_id -> category

    function weightedScore(row) {
      const scored = [];
      for (const p of (row.plugins || [])) {
        if (p.score == null) continue;
        const cat = categoryOf[p.plugin_id];
        const w = cat && currentWeights[cat] != null ? currentWeights[cat] : 1.0;
        scored.push([p.score, w]);
      }
      const totalW = scored.reduce((s, [, w]) => s + w, 0);
      if (!totalW) return null;
      return scored.reduce((s, [sc, w]) => s + sc * w, 0) / totalW;
    }

    async function deleteRun(runId) {
      const confirmed = await confirmModal({
        title: 'Delete benchmark?',
        body: `Delete benchmark ${runId}? This cannot be undone.`,
        confirmLabel: 'Delete',
      });
      if (!confirmed) return;
      try {
        const res = await fetch(`/api/benchmarks/${encodeURIComponent(runId)}`, { method: 'DELETE' });
        if (!res.ok) throw new Error(`Delete failed (HTTP ${res.status})`);
        toast('Benchmark deleted', 'success');
        location.href = '/history';
      } catch (err) {
        toast(`Error: ${err.message}`, 'error');
      }
    }

    async function loadCases(runId) {
      const res = await fetch(`/api/benchmarks/${encodeURIComponent(runId)}/cases`);
      if (!res.ok) throw new Error('Failed to load cases');
      return (await res.json()).cases || [];
    }

    const renderErrors = async (runIds) => {
      const detail = document.getElementById('errors-detail');
      if (!detail) return;
      detail.innerHTML = '<p style="color:#94a3b8;">Loading errors…</p>';
      try {
        const perRun = await Promise.all(runIds.map((id) => loadCases(id).catch(() => [])));
        let html = '';
        let any = false;
        runIds.forEach((id, i) => {
          const cases = perRun[i] || [];
          const bad = cases.filter((c) => c.error || (c.passed === 0));
          if (!bad.length) return;
          any = true;
          html += `<div style="margin-bottom:1rem;">
            <strong style="color:#e2e8f0">${esc(id)}</strong>
            <table style="width:100%; border-collapse:collapse; margin-top:.375rem; font-size:.85rem;">
              <tr style="border-bottom:1px solid #334155;"><th style="text-align:left;padding:.3rem .75rem;color:#94a3b8;">Model</th><th style="text-align:left;padding:.3rem .75rem;color:#94a3b8;">Plugin</th><th style="text-align:left;padding:.3rem .75rem;color:#94a3b8;">Case</th><th style="text-align:left;padding:.3rem .75rem;color:#ef4444;">Error</th></tr>`;
          bad.forEach((c) => {
            html += `<tr style="border-bottom:1px solid #334155;">
              <td style="padding:.3rem .75rem;">${esc(c.model_name)}</td>
              <td style="padding:.3rem .75rem;">${esc(c.plugin_id)}</td>
              <td style="padding:.3rem .75rem; font-family:monospace;">${esc(c.case_id)}</td>
              <td style="padding:.3rem .75rem;">${esc(c.error || 'evaluate failed')}</td></tr>`;
          });
          html += `</table></div>`;
        });
        detail.innerHTML = any ? html : '<p style="color:#94a3b8; font-size:.875rem;">No errors found for the selected run(s).</p>';
        detail.dataset.rendered = 'true';
      } catch (e) {
        detail.innerHTML = `<p style="color:#ef4444;">Error: ${(e && e.message) || e}</p>`;
      }
    };

    async function collectPlugins(runIds) {
      if (!runIds.length) return [];
      const seen = new Map();
      for (const id of runIds) {
        try {
          const r = await fetch(`/api/benchmarks/${encodeURIComponent(id)}`);
          if (!r.ok) continue;
          const body = await r.json();
          for (const m of (body.models || [])) {
            for (const p of (m.plugins || [])) {
              if (!seen.has(p.plugin_id)) seen.set(p.plugin_id, p);
            }
          }
        } catch { /* keep going */ }
      }
      return Array.from(seen.values());
    }

    async function load() {
      const el = document.getElementById('compare');
      const errEl = document.getElementById('error');
      try {
        const params = new URLSearchParams(location.search);
        const runIds = params.getAll('run');
        currentRunIds = runIds;
        const [plugins, pluginIndex, weightsData] = await Promise.all([
          collectPlugins(runIds),
          fetch('/api/plugins').then((r) => (r.ok ? r.json() : { compare_default: [], plugins: [] })),
          fetch('/api/weights').then((r) => (r.ok ? r.json() : { defaults: {}, effective: {} })),
        ]);
        const compareDefault = pluginIndex.compare_default || [];
        defaultWeights = weightsData.defaults || {};
        currentWeights = weightsData.effective || {};
        for (const p of (pluginIndex.plugins || [])) categoryOf[p.id] = p.category;
        // Per-plugin columns come from the plugin registry (always available),
        // plus any plugin found in run data that is no longer in the registry.
        const pluginList = [...(pluginIndex.plugins || []).map((p) => ({ plugin_id: p.id }))];
        const knownIds = new Set(pluginList.map((p) => p.plugin_id));
        for (const p of plugins) if (!knownIds.has(p.plugin_id)) pluginList.push(p);
        currentCols = buildColumns(pluginList, compareDefault, runIds.length > 1);
        const keys = storage.orderOk(currentCols);
        // Seed localStorage with default visibility (only defaultVisible cols) on first visit.
        if (!localStorage.getItem(VISIBLE_KEY)) {
          storage.setVisible(keys.filter((k) => currentCols[k].defaultVisible));
        }
        renderColumnToggles(currentCols, keys);

        const url = runIds.length
          ? `/api/compare?${runIds.map((r) => 'run=' + encodeURIComponent(r)).join('&')}`
          : '/api/compare';
        const res = await fetch(url);
        if (!res.ok) throw new Error('Failed to fetch comparison');
        const data = await res.json();
        const rows = data.models || [];
        el.innerHTML = rows.length ? compareTable(rows, runIds, currentCols) : emptyState();
      } catch (e) {
        el.innerHTML = '';
        errEl.style.display = 'block';
        errEl.textContent = `Error: ${e.message}`;
      }
    }

    const GROUP_ORDER = ['General', 'Latency', 'Per-plugin'];

    function renderColumnToggles(cols, order) {
      const groups = document.getElementById('column-groups');
      if (!groups) return;
      groups.innerHTML = '';
      const v = storage.visible();
      const allOn = v === null;
      const byGroup = {};
      for (const k of order) {
        const c = cols[k];
        (byGroup[c.group] = byGroup[c.group] || []).push([k, c]);
      }
      const groupNames = GROUP_ORDER.filter((g) => byGroup[g]).concat(
        Object.keys(byGroup).filter((g) => !GROUP_ORDER.includes(g))
      );
      for (const g of groupNames) {
        const section = document.createElement('div');
        section.dataset.groupSection = g;
        section.style.marginBottom = '.75rem';
        const header = document.createElement('div');
        header.style.cssText = 'display:flex; align-items:center; justify-content:space-between; margin-bottom:.35rem;';
        header.innerHTML =
          `<span style="color:#e2e8f0; font-size:.72rem; font-weight:600; text-transform:uppercase; letter-spacing:.05em;">${esc(g)}</span>
           <span style="display:flex; gap:.6rem;">
             <a href="#" data-cols-group="${esc(g)}" data-group-action="all" style="color:#3b82f6; font-size:.75rem;">All</a>
             <a href="#" data-cols-group="${esc(g)}" data-group-action="none" style="color:#94a3b8; font-size:.75rem;">None</a>
           </span>`;
        section.appendChild(header);
        const list = document.createElement('div');
        list.style.cssText = 'display:flex; flex-wrap:wrap; gap:.25rem .75rem;';
        for (const [k, c] of byGroup[g]) {
          const on = allOn || v.has(k);
          const row = document.createElement('label');
          row.style.cssText = 'display:flex; align-items:center; gap:.3rem; font-size:.8rem; color:#cbd5e1; cursor:pointer;';
          row.innerHTML =
            `<input type="checkbox" data-col="${esc(k)}" ${on ? 'checked' : ''} style="accent-color:#3b82f6; margin:0;">
             <span>${esc(c.label)}</span>`;
          list.appendChild(row);
        }
        section.appendChild(list);
        groups.appendChild(section);
      }
      const count = document.getElementById('column-count');
      if (count) {
        const on = allOn ? order.length : order.filter((k) => v.has(k)).length;
        count.textContent = `Showing ${on} of ${order.length} columns`;
      }
      applyColumnSearch();
    }

    function applyColumnSearch() {
      const searchEl = document.getElementById('column-search');
      if (!searchEl) return;
      const q = searchEl.value.trim().toLowerCase();
      document.querySelectorAll('#column-groups [data-group-section]').forEach((section) => {
        let visible = 0;
        section.querySelectorAll('label').forEach((row) => {
          const match = !q || row.textContent.toLowerCase().includes(q);
          row.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        section.style.display = visible ? '' : 'none';
      });
    }

    const getRoot = () => document.getElementById('compare');

    getRoot()?.addEventListener('click', async (e) => {
      // Sort by column header.
      let th = e.target.closest('th[data-sort]');
      if (th) {
        const key = th.dataset.sort;
        if (key) {
          const cur = storage.sort();
          const dir = (cur.key === key && cur.dir === 'desc') ? 'asc' : 'desc';
          storage.setSort(key, dir);
          load();
        }
        return;
      }
      // Delete run(s) button.
      let btn = e.target.closest('button[data-delete-run]');
      if (btn) {
        const ids = btn.dataset.deleteRun ? btn.dataset.deleteRun.split(',') : [];
        if (ids.length === 1) { deleteRun(ids[0]); return; }
        const confirmed = await confirmModal({
          title: 'Delete multiple benchmarks?',
          body: `Delete ${ids.length} runs (${ids.join(', ')})? This cannot be undone.`,
          confirmLabel: 'Delete all',
        });
        if (!confirmed) return;
        try {
          const res = await fetch('/api/benchmarks/delete', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ run_ids: ids }),
          });
          if (!res.ok) throw new Error(`Delete failed (HTTP ${res.status})`);
          toast('Benchmarks deleted', 'success');
          location.href = '/history';
        } catch (err) {
          toast(`Error: ${err.message}`, 'error');
        }
        return;
      }
      // Show/hide per-case errors panel.
        const showErr = e.target.closest('button#show-errors');
        if (showErr) {
          const detail = document.getElementById('errors-detail');
          if (!detail) return;
          if (detail.dataset.rendered === 'true') {
            detail.innerHTML = '';
            detail.dataset.rendered = '';
            showErr.textContent = 'Show per-case errors';
            return;
          }
          await renderErrors(currentRunIds);
          showErr.textContent = 'Hide errors';
        }
    });

    const refreshToggles = () => renderColumnToggles(currentCols, storage.orderOk(currentCols));

    document.getElementById('column-panel')?.addEventListener('click', (e) => {
      // Global All / Clear buttons.
      const action = e.target.closest('[data-cols-action]');
      if (action) {
        e.preventDefault();
        const set = action.dataset.colsAction === 'all'
          ? new Set(Object.keys(currentCols))
          : new Set();
        storage.setVisible([...set]);
        refreshToggles();
        load();
        return;
      }
      // Per-group All / None links.
      const grp = e.target.closest('[data-cols-group]');
      if (grp) {
        e.preventDefault();
        const g = grp.dataset.colsGroup;
        const act = grp.dataset.groupAction;
        const keys = Object.keys(currentCols).filter((k) => currentCols[k].group === g);
        const set = storage.visible() ?? new Set(Object.keys(currentCols));
        keys.forEach((k) => { if (act === 'all') set.add(k); else set.delete(k); });
        storage.setVisible([...set]);
        refreshToggles();
        load();
        return;
      }
      const toggle = e.target.closest('input[type="checkbox"][data-col]');
      if (!toggle) return;
      const key = toggle.dataset.col;
      const v = storage.visible();
      const set = v === null ? new Set(storage.order(currentCols)) : v;
      if (toggle.checked) set.add(key); else set.delete(key);
      storage.setVisible([...set]);
      load();
    });

    document.getElementById('reset-columns')?.addEventListener('click', () => {
      localStorage.removeItem(VISIBLE_KEY);
      localStorage.removeItem(ORDER_KEY);
      load();
    });

    document.getElementById('toggle-columns')?.addEventListener('click', () => {
      const popover = document.getElementById('columns-popover');
      if (!popover) return;
      const show = popover.style.display === 'none';
      popover.style.display = show ? 'block' : 'none';
      const btn = document.getElementById('toggle-columns');
      if (btn) {
        btn.textContent = show ? '▴' : '▾';
        btn.setAttribute('aria-expanded', String(show));
      }
      if (show) refreshToggles();
    });

    document.getElementById('column-search')?.addEventListener('input', applyColumnSearch);

    document.addEventListener('click', (e) => {
      const popover = document.getElementById('columns-popover');
      if (!popover || popover.style.display === 'none') return;
      const panel = document.getElementById('column-panel');
      if (panel && !panel.contains(e.target)) {
        popover.style.display = 'none';
        const btn = document.getElementById('toggle-columns');
        if (btn) { btn.textContent = '▾'; btn.setAttribute('aria-expanded', 'false'); }
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const popover = document.getElementById('columns-popover');
      if (!popover || popover.style.display === 'none') return;
      popover.style.display = 'none';
      const btn = document.getElementById('toggle-columns');
      if (btn) { btn.textContent = '▾'; btn.setAttribute('aria-expanded', 'false'); }
    });

    // --- Weights panel ---
    function renderWeightsInputs() {
      const list = document.getElementById('weights-inputs');
      if (!list) return;
      list.innerHTML = '';
      const frag = document.createElement('div');
      frag.style.display = 'contents';
      for (const [cat, def] of Object.entries(defaultWeights)) {
        const val = currentWeights[cat] != null ? currentWeights[cat] : def;
        const changed = Number(val) !== Number(def);
        frag.insertAdjacentHTML('beforeend',
          `<label style="display:flex; flex-direction:column; gap:.25rem; font-size:.8rem; color:#94a3b8;">
            <span>${esc(cat)}</span>
            <input type="number" min="0" step="0.1" data-weight="${esc(cat)}" value="${esc(String(val))}"
              style="width:5.5rem; background:#1e293b; color:#e2e8f0; border:1px solid ${changed ? '#3b82f6' : '#334155'}; border-radius:.25rem; padding:.3rem .5rem;">
          </label>`);
      }
      list.appendChild(frag);
    }

    document.getElementById('toggle-weights')?.addEventListener('click', () => {
      const panel = document.getElementById('weights-panel');
      if (!panel) return;
      const show = panel.style.display === 'none';
      panel.style.display = show ? 'block' : 'none';
      if (show) renderWeightsInputs();
    });

    document.getElementById('weights-save')?.addEventListener('click', async () => {
      const weights = {};
      for (const inp of document.querySelectorAll('#weights-inputs input[data-weight]')) {
        weights[inp.dataset.weight] = parseFloat(inp.value);
      }
      try {
        const res = await fetch('/api/weights', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ weights }),
        });
        if (!res.ok) throw new Error(`Save failed (HTTP ${res.status})`);
        const data = await res.json();
        defaultWeights = data.defaults;
        currentWeights = data.effective;
        renderWeightsInputs();
        toast('Weights saved', 'success');
        load();
      } catch (err) {
        toast(`Error: ${err.message}`, 'error');
      }
    });

    document.getElementById('weights-reset')?.addEventListener('click', async () => {
      const weights = {};
      for (const [cat, def] of Object.entries(defaultWeights)) weights[cat] = def;
      try {
        const res = await fetch('/api/weights', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ weights }),
        });
        if (!res.ok) throw new Error(`Reset failed (HTTP ${res.status})`);
        const data = await res.json();
        defaultWeights = data.defaults;
        currentWeights = data.effective;
        renderWeightsInputs();
        toast('Weights reset to defaults', 'success');
        load();
      } catch (err) {
        toast(`Error: ${err.message}`, 'error');
      }
    });

    load();
  </script>
</MainLayout>
