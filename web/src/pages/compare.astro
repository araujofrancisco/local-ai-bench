---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Compare Models">
  <h1>Model Comparison</h1>

  <div id="error" style="display: none; background: #ef4444; color: white; padding: 1rem; border-radius: 0.5rem; margin-bottom: 2rem;"></div>

  <div id="compare">
    <p style="color: #94a3b8;">Loading comparison…</p>
  </div>

  <script>
    import { esc, toast, confirmModal } from '../scripts/ui.js';

    const fmt = (v, d) => (v === null || v === undefined ? '-' : Number(v).toFixed(d));

    const scoreColor = (s) =>
      s === null || s === undefined ? 'inherit' : s >= 0.8 ? '#10b981' : s >= 0.5 ? '#f59e0b' : '#ef4444';

    const HINTS = {
      'p50 (ms)': 'Median generation latency — half of generations finish faster, half slower.',
      'p95 (ms)': 'Tail latency: 95% of generations finish within this time. Sensitive to slow decodes/outliers.',
      'TTFT p50': 'Median time to first token — measures prompt processing + first-token latency (server load, context length).',
      'Tokens/s': 'Output tokens generated per second (throughput).',
      'Score': 'Weighted mean of plugin scores (higher is better).',
    };

    // Render a header cell with an inline '?' tooltip hint.
    const th = (label, align = 'right') => {
      const hint = HINTS[label];
      return `<th title="${hint}" style="text-align:${align}; padding:1rem; color:#94a3b8; font-weight:500;">
        ${label}${hint ? `<span aria-label="${hint}" style="display:inline-flex;align-items:center;justify-content:center;width:1.1rem;height:1.1rem;border-radius:50%;color:#64748b;font-size:.7rem;border:1px solid #444;margin-left:.25rem;cursor:help;">?</span>` : ''}
      </th>`;
    };

    const compareTable = (rows, runId) => {
      const header = runId ? `
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; background:#1e293b; padding:.75rem 1rem; border-radius:.5rem; border:1px solid #334155;">
          <span style="color:#94a3b8; font-size:.875rem;">Run <code style="background:#0f172a; padding:.125rem .375rem; border-radius:.25rem;">${esc(runId)}</code></span>
          <button data-delete-run style="background:transparent; color:#ef4444; border:1px solid #7f1d1d; padding:.375rem .875rem; border-radius:.375rem; cursor:pointer; font-size:.875rem;">Delete run</button>
        </div>` : '';
      return header + `
      <div style="overflow-x:auto; background:#1e293b; border-radius:.5rem; border:1px solid #334155;">
        <table style="width:100%; border-collapse:collapse;">
          <thead>
            <tr style="border-bottom:1px solid #334155;">
              ${th('Model', 'left')}
              ${th('Score')}
              ${th('p50 (ms)')}
              ${th('p95 (ms)')}
              ${th('TTFT p50')}
              ${th('Tokens/s')}
              ${th('Cases')}
              ${th('Errors')}
            </tr>
          </thead>
          <tbody>
            ${rows.map((row, i) => `
              <tr style="border-bottom:1px solid #334155; background:${i % 2 === 0 ? 'transparent' : 'rgba(255,255,255,0.02)'};">
                <td style="padding:1rem; font-weight:500;">${esc(row.model_name)}</td>
                <td style="text-align:right; padding:1rem; color:${scoreColor(row.overall_score)};">${fmt(row.overall_score, 3)}</td>
                <td style="text-align:right; padding:1rem;">${fmt(row.latency_p50_ms, 1)}</td>
                <td style="text-align:right; padding:1rem;">${fmt(row.latency_p95_ms, 1)}</td>
                <td style="text-align:right; padding:1rem;">${fmt(row.time_to_first_token_p50_ms, 1)}</td>
                <td style="text-align:right; padding:1rem;">${fmt(row.tokens_per_second, 1)}</td>
                <td style="text-align:right; padding:1rem;">${row.cases_run || 0}</td>
                <td style="text-align:right; padding:1rem; color:${row.errors > 0 ? '#ef4444' : 'inherit'};">${row.errors || 0}</td>
              </tr>`).join('')}
          </tbody>
        </table>
      </div>
      <div style="margin-top:1rem; display:flex; flex-wrap:wrap; gap:1.5rem; font-size:.8rem; color:#64748b;">
        <span><strong>p50/p95 (ms)</strong>: median / 95th-percentile generation latency across cases.</span>
        <span><strong>TTFT p50</strong>: median time to first token (prompt processing + first-token latency).</span>
        <span><strong>Tokens/s</strong>: output tokens per second (throughput).</span>
      </div>
      <div style="margin-top:2rem; display:flex; gap:1rem;">
        <a href="/run" style="background:#3b82f6; color:white; padding:.75rem 2rem; border-radius:.375rem; text-decoration:none; font-weight:500;">Run More Benchmarks</a>
        <a href="/history" style="background:#64748b; color:white; padding:.75rem 2rem; border-radius:.375rem; text-decoration:none; font-weight:500;">View History</a>
      </div>`;
    };

    const emptyState = () => `
      <div style="background:#1e293b; padding:2rem; border-radius:.5rem; border:1px solid #334155; text-align:center;">
        <p style="color:#94a3b8; margin-bottom:1rem;">No benchmark data available yet.</p>
        <a href="/run" style="color:#3b82f6; text-decoration:none; font-weight:500;">Run your first benchmark →</a>
      </div>`;

    let currentRunId = null;

    async function deleteRun(runId) {
      const confirmed = await confirmModal({
        title: 'Delete benchmark?',
        body: `Delete benchmark ${runId}? This cannot be undone.`,
        confirmLabel: 'Delete',
      });
      if (!confirmed) return;
      try {
        const res = await fetch(`/api/benchmarks/${encodeURIComponent(runId)}`, { method: 'DELETE' });
        if (!res.ok) throw new Error(`Delete failed (HTTP ${res.status})`);
        toast('Benchmark deleted', 'success');
        location.href = '/history';
      } catch (err) {
        toast(`Error: ${err.message}`, 'error');
      }
    }

    async function load() {
      const el = document.getElementById('compare');
      const errEl = document.getElementById('error');
      try {
        currentRunId = new URLSearchParams(location.search).get('run');
        const url = currentRunId ? `/api/benchmarks/${encodeURIComponent(currentRunId)}` : '/api/compare';
        const res = await fetch(url);
        if (!res.ok) throw new Error('Failed to fetch comparison');
        const data = await res.json();
        const rows = data.models || [];
        el.innerHTML = rows.length ? compareTable(rows, currentRunId) : emptyState();
      } catch (e) {
        el.innerHTML = '';
        errEl.style.display = 'block';
        errEl.textContent = `Error: ${e.message}`;
      }
    }

    document.getElementById('compare').addEventListener('click', (e) => {
      if (e.target.closest('button[data-delete-run]') && currentRunId) deleteRun(currentRunId);
    });

    load();
  </script>
</MainLayout>
