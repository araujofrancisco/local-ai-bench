---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Dashboard">
  <h1>Dashboard</h1>

  <div id="error" style="display: none; background: #ef4444; color: white; padding: 1rem; border-radius: 0.5rem; margin-bottom: 2rem;"></div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
    <div style="background: #1e293b; padding: 1.5rem; border-radius: 0.5rem; border: 1px solid #334155;">
      <div style="color: #94a3b8; font-size: 0.875rem; margin-bottom: 0.5rem;">Total Models</div>
      <div id="stat-models" style="font-size: 2rem; font-weight: bold; color: #f1f5f9;">…</div>
    </div>
    <div style="background: #1e293b; padding: 1.5rem; border-radius: 0.5rem; border: 1px solid #334155;">
      <div style="color: #94a3b8; font-size: 0.875rem; margin-bottom: 0.5rem;">Total Benchmarks</div>
      <div id="stat-runs" style="font-size: 2rem; font-weight: bold; color: #f1f5f9;">…</div>
    </div>
    <div style="background: #1e293b; padding: 1.5rem; border-radius: 0.5rem; border: 1px solid #334155;">
      <div style="color: #94a3b8; font-size: 0.875rem; margin-bottom: 0.5rem;">Last Run</div>
      <div id="stat-last" style="font-size: 1.25rem; font-weight: bold; color: #f1f5f9;">…</div>
    </div>
  </div>

  <h2>Active Runs</h2>
  <div id="active-runs">
    <p style="color: #94a3b8;">Checking for active runs…</p>
  </div>

  <h2>Available Models</h2>
  <div id="models" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem;"></div>

  <h2>Recent Benchmarks</h2>
  <div id="runs"></div>

  <script>
    import { esc, toast, confirmModal } from '../scripts/ui.js';

    const modelCard = (m) => `
      <div style="background:#1e293b; padding:1.5rem; border-radius:.5rem; border:1px solid #334155;">
        <div style="display:flex; justify-content:space-between; align-items:start; margin-bottom:.75rem;">
          <h3 style="color:#f1f5f9; font-size:1.125rem; font-weight:600;">${esc(m.name)}</h3>
          <div style="display:flex; gap:.5rem;">
            ${m.supports_vision ? '<span style="background:#7c3aed; color:white; padding:.25rem .5rem; border-radius:.25rem; font-size:.75rem;">Vision</span>' : ''}
            ${m.supports_tools ? '<span style="background:#059669; color:white; padding:.25rem .5rem; border-radius:.25rem; font-size:.75rem;">Tools</span>' : ''}
          </div>
        </div>
        <div style="color:#94a3b8; font-size:.875rem; margin-bottom:.5rem;">${esc(m.host)}</div>
        ${m.max_context ? `<div style="color:#64748b; font-size:.75rem;">Context: ${Number(m.max_context).toLocaleString()} tokens</div>` : ''}
      </div>`;

    const runsTable = (runs) => `
      <div style="background:#1e293b; border-radius:.5rem; border:1px solid #334155; overflow:hidden;">
        <table style="width:100%; border-collapse:collapse;">
          <thead>
            <tr style="border-bottom:1px solid #334155; background:rgba(255,255,255,0.02);">
              <th style="text-align:left; padding:1rem; color:#94a3b8; font-weight:500;">Run ID</th>
              <th style="text-align:left; padding:1rem; color:#94a3b8; font-weight:500;">Timestamp</th>
              <th style="text-align:left; padding:1rem; color:#94a3b8; font-weight:500;">Models</th>
              <th style="text-align:right; padding:1rem; color:#94a3b8; font-weight:500;">Actions</th>
            </tr>
          </thead>
          <tbody>
            ${runs.map((run, i) => `
              <tr style="border-bottom:1px solid #334155; background:${i % 2 === 0 ? 'transparent' : 'rgba(255,255,255,0.02)'};">
                <td style="padding:1rem; font-family:monospace; font-size:.875rem;">${esc(run.run_id)}</td>
                <td style="padding:1rem;">${new Date(run.timestamp).toLocaleString()}</td>
                <td style="padding:1rem;">${esc(run.model_names ? run.model_names.join(', ') : '-')}</td>
                <td style="text-align:right; padding:1rem; white-space:nowrap;">
                  <a href="/compare?run=${esc(run.run_id)}" style="color:#3b82f6; text-decoration:none; font-weight:500; margin-right:1rem;">View</a>
                  <button data-delete="${esc(run.run_id)}" style="background:transparent; color:#ef4444; border:1px solid #7f1d1d; padding:.25rem .625rem; border-radius:.375rem; cursor:pointer; font-size:.875rem;">Delete</button>
                </td>
              </tr>`).join('')}
          </tbody>
        </table>
      </div>`;

    const activeRuns = (runs) => {
      if (!runs.length) return '<p style="color:#64748b;">No benchmarks running.</p>';
      return runs.map((run) => {
        const pct = Math.round((run.progress || 0) * 100);
        const queued = run.status === 'pending';
        const detail = [run.model, run.plugin].filter(Boolean).join(' · ') || (run.models || []).join(', ');
        return `
          <div style="background:#1e293b;padding:1rem;border-radius:.5rem;border:1px solid #334155;margin-bottom:.75rem;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem;gap:1rem;">
              <div style="min-width:0;">
                <span style="font-family:monospace;font-size:.875rem;color:#e2e8f0;">${esc(run.run_id)}</span>
                ${detail ? `<span style="margin-left:.5rem;color:#94a3b8;font-size:.875rem;">${esc(detail)}</span>` : ''}
              </div>
              <div style="display:flex;gap:.75rem;align-items:center;white-space:nowrap;">
                <span style="color:#f59e0b;font-size:.875rem;">${queued ? 'Queued…' : `${pct}% complete`}</span>
                <a href="/run?run=${esc(run.run_id)}" style="color:#3b82f6;text-decoration:none;font-weight:500;">Track →</a>
              </div>
            </div>
            <div style="background:#0f172a;height:.625rem;border-radius:.375rem;overflow:hidden;border:1px solid #334155;">
              <div style="background:${queued ? '#f59e0b' : '#3b82f6'};height:100%;width:${pct}%;transition:width .3s;"></div>
            </div>
          </div>`;
      }).join('');
    };

    async function load() {
      const errEl = document.getElementById('error');
      try {
        const [modelsRes, runsRes] = await Promise.all([
          fetch('/api/models'),
          fetch('/api/benchmarks'),
        ]);
        if (!modelsRes.ok || !runsRes.ok) throw new Error('Failed to fetch data');
        const models = (await modelsRes.json()).models || [];
        const allRuns = (await runsRes.json()).runs || [];
        const runs = allRuns.slice(0, 5);

        document.getElementById('stat-models').textContent = models.length;
        document.getElementById('stat-runs').textContent = allRuns.length;
        document.getElementById('stat-last').textContent = allRuns[0]
          ? new Date(allRuns[0].timestamp).toLocaleDateString()
          : 'Never';

        const modelsEl = document.getElementById('models');
        modelsEl.innerHTML = models.length
          ? models.map(modelCard).join('')
          : '<p style="color:#94a3b8;">No models found. Make sure Ollama is running.</p>';

        document.getElementById('runs').innerHTML = runs.length ? runsTable(runs) : '';
      } catch (e) {
        errEl.style.display = 'block';
        errEl.textContent = `Error: ${e.message}`;
      }
    }

    async function loadActive() {
      try {
        const res = await fetch('/api/benchmarks/active');
        if (!res.ok) return;
        const runs = (await res.json()).runs || [];
        document.getElementById('active-runs').innerHTML = activeRuns(runs);
      } catch (e) {
        // Backend briefly unreachable; keep the previous render.
      }
    }

    async function deleteRun(runId, btn) {
      const confirmed = await confirmModal({
        title: 'Delete benchmark?',
        body: `Delete benchmark ${runId}? This cannot be undone.`,
        confirmLabel: 'Delete',
      });
      if (!confirmed) return;
      btn.disabled = true;
      try {
        const res = await fetch(`/api/benchmarks/${encodeURIComponent(runId)}`, { method: 'DELETE' });
        if (!res.ok) throw new Error(`Delete failed (HTTP ${res.status})`);
        toast('Benchmark deleted', 'success');
        load();
      } catch (err) {
        btn.disabled = false;
        toast(`Error: ${err.message}`, 'error');
      }
    }

    document.getElementById('runs').addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-delete]');
      if (btn) deleteRun(btn.dataset.delete, btn);
    });

    load();
    loadActive();
    setInterval(loadActive, 3000);
  </script>
</MainLayout>
